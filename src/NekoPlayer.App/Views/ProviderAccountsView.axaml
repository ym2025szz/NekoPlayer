<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NekoPlayer.App.ViewModels" x:Class="NekoPlayer.App.Views.ProviderAccountsView"
             x:Name="AccountsView" x:DataType="vm:ProviderAccountsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.accountRow"><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Border.accountRow.focused"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/></Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="账号与授权" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshCommand}"/></Grid>
    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
    <Border IsVisible="{Binding IsLoginVisible}" Background="#20383D" CornerRadius="16" Padding="18">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding LoginTitle}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/><Button Grid.Column="1" Content="关闭" Command="{Binding CloseLoginCommand}"/></Grid>
        <Border Background="White" CornerRadius="10" Padding="10" Width="212" Height="212" HorizontalAlignment="Center" IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNotNull}}"><Image Source="{Binding QrImage}" Width="192" Height="192" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="平台扫码登录二维码"/></Border>
        <TextBlock Text="{Binding LoginMessage}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AccentBrightBrush}" AutomationProperties.LiveSetting="Polite"/>
        <Button Content="刷新二维码" Command="{Binding RefreshQrCommand}" IsVisible="{Binding CanRefreshQr}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
    <ItemsControl x:Name="AccountRows" ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProviderAccountRow">
      <Border Classes="accountRow" Classes.focused="{Binding IsFocused}" BorderThickness="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,8">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4"><TextBlock Text="{Binding Account.Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrightBrush}" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="accent" Content="{Binding LoginText}" IsVisible="{Binding CanLogin}" Command="{ReflectionBinding #AccountsView.DataContext.LoginCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Account.Name, StringFormat='扫码登录{0}'}"/><Button Content="退出登录" IsVisible="{Binding CanLogout}" Command="{ReflectionBinding #AccountsView.DataContext.LogoutCommand}" CommandParameter="{Binding}"/></StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Account.Message}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
</UserControl>
