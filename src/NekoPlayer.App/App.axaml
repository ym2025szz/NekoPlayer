<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NekoPlayer.App"
             xmlns:conv="using:NekoPlayer.App.Converters"
             x:Class="NekoPlayer.App.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates><local:ViewLocator/></Application.DataTemplates>
  <Application.Resources>
    <Color x:Key="BackgroundColor">#10171B</Color><SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#162328"/><SolidColorBrush x:Key="CardBrush" Color="#1B2D32"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#243A40"/><SolidColorBrush x:Key="AccentBrush" Color="#39C5BB"/>
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#5EE8DE"/><SolidColorBrush x:Key="AccentDarkBrush" Color="#168D89"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#FF6FAE"/><SolidColorBrush x:Key="PurpleBrush" Color="#A98BFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2FAFA"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8C1C4"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#617679"/><SolidColorBrush x:Key="ErrorBrush" Color="#FF647C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC857"/>
    <conv:DurationConverter x:Key="DurationConverter"/><conv:BooleanInverseConverter x:Key="BooleanInverseConverter"/><conv:RelativeTimeConverter x:Key="RelativeTimeConverter"/><conv:FileAvailabilityConverter x:Key="FileAvailabilityConverter"/><conv:SnackbarBrushConverter x:Key="SnackbarBrushConverter"/>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI"/></Style>
    <Style Selector="Button"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,9"/></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource HoverBrush}"/></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="Transparent"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.nav /template/ ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Grid.navContent"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="#28464B"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
    <Style Selector="Button.icon"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon /template/ ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.accent.icon"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/></Style>
    <Style Selector="PathIcon"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#29454B"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12,9"/></Style>
    <Style Selector="ComboBox"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#28464B"/></Style>
    <Style Selector="Border.queueCurrent"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="Background" Value="#20383D"/></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="#102126"/><Setter Property="Height" Value="8"/><Setter Property="CornerRadius" Value="4"/></Style>
  </Application.Styles>
</Application>
